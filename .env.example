# Copia a .env y ajusta. NUNCA subas .env al repositorio (§15).
DJANGO_SECRET_KEY=dev-solo-para-local-cambiala
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes del frontend (no comparte origen con la API). Sin esto, toda escritura
# autenticada desde el navegador se queda en un 403 de CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5177,http://127.0.0.1:5177

# Postgres local (docker compose up -d) — puerto no estándar del proyecto
DATABASE_URL=postgres://blens:blens@localhost:5434/blens_dev

# Celery: en local Redis; en AWS, SQS (sqs://) en eu-west-1
CELERY_BROKER_URL=redis://localhost:6381/0

AWS_REGION=eu-west-1
