{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "backend/manage.py",
        "runserver",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev"
      ],
      "port": 5177
    }
  ]
}
